@model Web.Models.Building
<form method="post" class="go-panel go-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="BuildingId" type="hidden" />
    <div class="go-form-grid">
        <div><label asp-for="BuildingName"></label><input asp-for="BuildingName" class="form-control" /></div>
        <div><label asp-for="BuildingType"></label><select asp-for="BuildingType" class="form-select"><option>APARTMENT</option><option>HOUSE</option><option>TOWNHOUSE</option><option>CONDO</option></select></div>
        <div><label asp-for="AddressLine1"></label><input asp-for="AddressLine1" class="form-control" /></div><div><label asp-for="AddressLine2"></label><input asp-for="AddressLine2" class="form-control" /></div>
        <div><label asp-for="City"></label><input asp-for="City" class="form-control" /></div><div><label asp-for="Province"></label><input asp-for="Province" class="form-control" /></div>
        <div><label asp-for="PostalCode"></label><input asp-for="PostalCode" class="form-control" /></div><div><label asp-for="UnitCount"></label><input asp-for="UnitCount" class="form-control" type="number" min="0" /></div>
        <div><label>@L["Status"]</label><select asp-for="Status" class="form-select"><option value="ACTIVE">@L["Active"]</option><option value="INACTIVE">@L["Inactive"]</option></select></div>
    </div>
    <div class="mt-3"><label asp-for="Notes"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
    <div class="go-form-actions"><button class="go-btn-primary" type="submit">@L["Save"]</button><a class="go-btn-secondary" asp-action="Index">@L["Cancel"]</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
