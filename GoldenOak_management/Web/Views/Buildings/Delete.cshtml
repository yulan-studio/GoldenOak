@model Web.Models.Building
@{ ViewData["Title"] = "删除楼宇"; }<div class="go-page-header"><div><div class="go-eyebrow">Property portfolio</div><h1 class="go-page-title">确认删除</h1></div></div><section class="go-panel"><p>确定要删除楼宇 <strong>@Model.BuildingName</strong> 吗？包含单元的楼宇不能删除。</p><form method="post"><input type="hidden" name="id" value="@Model.BuildingId" /><button class="go-btn-primary" type="submit">确认删除</button> <a class="go-btn-secondary" asp-action="Index">取消</a></form></section>
