@model IReadOnlyList<Web.Models.Building>
@{ ViewData["Title"] = L["BuildingsTitle"]; }
<div class="go-page-header"><div><div class="go-eyebrow">@L["PropertyPortfolio"]</div><h1 class="go-page-title">@L["BuildingsTitle"]</h1><div class="go-page-subtitle">@L["ManageBuildingsUnits"]</div></div><a class="go-btn-primary" asp-action="Create">＋ @L["AddBuilding"]</a></div>
@if (TempData["Error"] is not null) { <div class="alert alert-warning">@TempData["Error"]</div> }
<section class="go-panel"><div class="table-responsive"><table class="go-table"><thead><tr><th>@L["BuildingsTitle"]</th><th>@L["Address"]</th><th>@L["Type"]</th><th>@L["UnitCount"]</th><th>@L["Status"]</th><th>@L["Actions"]</th></tr></thead><tbody>@foreach (var b in Model) { <tr><td><strong>@b.BuildingName</strong></td><td>@b.AddressLine1, @b.City, @b.Province</td><td>@b.BuildingType</td><td>@b.Units.Count</td><td><span class="go-status go-status-success">@b.Status</span></td><td class="go-actions"><a asp-action="Units" asp-route-id="@b.BuildingId">@L["UnitsTitle"]</a><a asp-action="Edit" asp-route-id="@b.BuildingId">@L["Edit"]</a><a asp-action="Delete" asp-route-id="@b.BuildingId">@L["Delete"]</a></td></tr> }</tbody></table></div></section>
