@model Web.Models.Building
@{ ViewData["Title"] = "单元"; }<div class="go-page-header"><div><div class="go-eyebrow">@Model.BuildingName</div><h1 class="go-page-title">单元</h1><div class="go-page-subtitle">@Model.AddressLine1, @Model.City, @Model.Province</div></div><div class="go-header-actions"><a class="go-btn-back" asp-controller="Buildings" asp-action="Index">← 返回楼宇</a><a class="go-btn-primary" asp-controller="Units" asp-action="Create" asp-route-buildingId="@Model.BuildingId">＋ 新增单元</a></div></div><section class="go-panel"><div class="table-responsive"><table class="go-table"><thead><tr><th>单元</th><th>卧室</th><th>卫生间</th><th>面积</th><th>租金</th><th>状态</th><th>操作</th></tr></thead><tbody>@foreach (var u in Model.Units.OrderBy(x => x.UnitNumber)) { <tr><td><strong>@u.UnitNumber</strong></td><td>@u.Bedrooms</td><td>@u.Bathrooms</td><td>@(u.SizeSqft?.ToString("N0") ?? "—")</td><td>@(u.AskingRent?.ToString("C0") ?? "—")</td><td><span class="go-status go-status-info">@u.Status</span></td><td class="go-actions"><a asp-controller="Units" asp-action="Edit" asp-route-id="@u.UnitId">编辑</a><a asp-controller="Units" asp-action="Delete" asp-route-id="@u.UnitId">删除</a></td></tr> }</tbody></table></div></section>
