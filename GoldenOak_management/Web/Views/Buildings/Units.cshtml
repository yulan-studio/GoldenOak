@model Web.Models.Building
@{ ViewData["Title"] = L["UnitsTitle"]; }<div class="go-page-header"><div><div class="go-eyebrow">@Model.BuildingName</div><h1 class="go-page-title">@L["UnitsTitle"]</h1><div class="go-page-subtitle">@Model.AddressLine1, @Model.City, @Model.Province</div></div><div class="go-header-actions"><a class="go-btn-back" asp-controller="Buildings" asp-action="Index">← @L["BackToBuildings"]</a><a class="go-btn-primary" asp-controller="Units" asp-action="Create" asp-route-buildingId="@Model.BuildingId">＋ @L["AddUnit"]</a></div></div><section class="go-panel"><div class="table-responsive"><table class="go-table"><thead><tr><th>@L["Unit"]</th><th>@L["Bedroom"]</th><th>@L["Bathroom"]</th><th>@L["Area"]</th><th>@L["Rent"]</th><th>@L["Status"]</th><th>@L["Actions"]</th></tr></thead><tbody>@foreach (var u in Model.Units.OrderBy(x => x.UnitNumber)) { <tr><td><strong>@u.UnitNumber</strong></td><td>@u.Bedrooms</td><td>@u.Bathrooms</td><td>@(u.SizeSqft?.ToString("N0") ?? "—")</td><td>@(u.AskingRent?.ToString("C0") ?? "—")</td><td><span class="go-status go-status-info">@u.Status</span></td><td class="go-actions"><a asp-controller="Units" asp-action="Edit" asp-route-id="@u.UnitId">@L["Edit"]</a><a asp-controller="Units" asp-action="Delete" asp-route-id="@u.UnitId">@L["Delete"]</a></td></tr> }</tbody></table></div></section>
