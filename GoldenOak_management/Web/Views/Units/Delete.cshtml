@model Web.Models.Unit
@{ ViewData["Title"] = L["ConfirmDelete"]; }
<div class="go-page-header"><div><div class="go-eyebrow">@Model.Building?.BuildingName</div><h1 class="go-page-title">@L["ConfirmDelete"] @L["UnitsTitle"]</h1></div></div>
<section class="go-panel"><p>@L["ConfirmUnitDelete"] <strong>@Model.UnitNumber</strong></p><p class="text-muted">@L["CurrentStatus"]：@Model.Status</p><form method="post" asp-action="Delete"><input type="hidden" name="id" value="@Model.UnitId" /><input type="hidden" name="buildingId" value="@Model.BuildingId" /><button class="go-btn-primary" type="submit">@L["ConfirmDelete"]</button> <a class="go-btn-back" asp-controller="Buildings" asp-action="Units" asp-route-id="@Model.BuildingId">@L["Cancel"]</a></form></section>
