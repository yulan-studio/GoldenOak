@model Web.Models.Unit
@{ ViewData["Title"] = "删除单元"; }
<div class="go-page-header"><div><div class="go-eyebrow">@Model.Building?.BuildingName</div><h1 class="go-page-title">确认删除单元</h1></div></div>
<section class="go-panel"><p>确定要删除单元 <strong>@Model.UnitNumber</strong> 吗？此操作不可恢复。</p><p class="text-muted">当前状态：@Model.Status</p><form method="post" asp-action="Delete"><input type="hidden" name="id" value="@Model.UnitId" /><input type="hidden" name="buildingId" value="@Model.BuildingId" /><button class="go-btn-primary" type="submit">确认删除</button> <a class="go-btn-back" asp-controller="Buildings" asp-action="Units" asp-route-id="@Model.BuildingId">取消</a></form></section>
