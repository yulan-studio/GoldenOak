@model Web.Models.CreateOwnerForUnitViewModel
@{ ViewData["Title"] = L["AddOwner"]; }
<div class="go-page-header"><div><div class="go-eyebrow">@Model.BuildingName · @L["Unit"] @Model.UnitNumber</div><h1 class="go-page-title">@L["AddOwner"]</h1><div class="go-page-subtitle">@L["OwnerInfoHint"]</div></div><div class="go-header-actions"><a class="go-btn-back" asp-controller="Units" asp-action="Owners" asp-route-id="@Model.UnitId">← @L["BackToOwners"]</a></div></div>
<section class="go-panel mb-4"><h2 class="go-panel-title">@L["SearchExistingOwner"]</h2><p class="text-muted">@L["OwnerSearchHint"]</p><div class="go-search-row"><input id="ownerSearchTerm" class="form-control" placeholder="@L["SearchPlaceholder"]" /><button id="ownerSearchButton" class="go-btn-primary" type="button">@L["Search"]</button></div><div id="ownerSearchResults" class="go-search-results"></div></section>
<section class="go-panel"><h2 class="go-panel-title">@L["CreateNewOwner"]</h2><form asp-action="CreateOwner" method="post" class="go-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="UnitId" type="hidden" /><div class="go-form-grid"><div><label asp-for="FullName">@L["Name"]</label><input asp-for="FullName" class="form-control" /></div><div><label asp-for="Email">@L["Email"]</label><input asp-for="Email" class="form-control" type="email" /></div><div><label asp-for="PhoneNumber">@L["Phone"]</label><input asp-for="PhoneNumber" class="form-control" /></div><div><label asp-for="MailingAddress">@L["MailingAddress"]</label><input asp-for="MailingAddress" class="form-control" /></div><div><label asp-for="OwnershipPercentage">@L["OwnershipPercentage"]</label><input asp-for="OwnershipPercentage" class="form-control" type="number" min="0.01" max="100" step="0.01" /></div><div><label asp-for="ValidFrom">@L["EffectiveDate"]</label><input asp-for="ValidFrom" class="form-control" type="date" /></div><div><label asp-for="BankName">@L["BankName"]</label><input asp-for="BankName" class="form-control" /></div><div><label asp-for="AccountHolderName">@L["AccountHolderName"]</label><input asp-for="AccountHolderName" class="form-control" /></div><div><label asp-for="AccountLastFour">@L["AccountLastFour"]</label><input asp-for="AccountLastFour" class="form-control" maxlength="4" inputmode="numeric" /></div><div><label asp-for="PayoutPreference">@L["PayoutPreference"]</label><select asp-for="PayoutPreference" class="form-select"><option value="BANK_TRANSFER">Bank Transfer</option><option value="CHEQUE">Cheque</option><option value="E_TRANSFER">E-Transfer</option></select></div><div><label><input asp-for="IsPrimaryPayoutOwner" /> @L["PrimaryPayoutOwner"]</label></div></div><div class="go-form-actions"><button class="go-btn-primary" type="submit">@L["SaveAndLinkOwner"]</button><a class="go-btn-back" asp-controller="Units" asp-action="Owners" asp-route-id="@Model.UnitId">@L["Cancel"]</a></div></form></section>
<script>
document.getElementById('ownerSearchButton').addEventListener('click', async function () {
    const term = document.getElementById('ownerSearchTerm').value.trim(), results = document.getElementById('ownerSearchResults');
    if (!term) { results.innerHTML = '<div class="text-muted mt-3">@L["EnterSearchTerm"]</div>'; return; }
    results.innerHTML = '<div class="text-muted mt-3">@L["Searching"]</div>';
    const response = await fetch('@Url.Action("SearchOwners", "Units")?unitId=@Model.UnitId&term=' + encodeURIComponent(term)), owners = await response.json();
    if (!owners.length) { results.innerHTML = '<div class="text-muted mt-3">@L["NoMatchingOwner"]</div>'; return; }
    results.innerHTML = owners.map(owner => `<div class="go-search-result"><div><strong>${owner.fullName}</strong><div class="text-muted small">${owner.email ?? ''} · ${owner.phoneNumber ?? ''} · ${owner.unitCount} units</div></div><button class="go-btn-secondary" type="button" ${owner.isAlreadyLinked ? 'disabled' : `data-owner-id="${owner.ownerId}"`}>${owner.isAlreadyLinked ? '@L["AlreadyLinked"]' : '@L["SelectOwner"]'}</button></div>`).join('');
    results.querySelectorAll('[data-owner-id]').forEach(button => button.addEventListener('click', () => { const form = document.createElement('form'); form.method = 'post'; form.action = '@Url.Action("AddExistingOwner", "Units")'; form.innerHTML = `<input name="__RequestVerificationToken" value="${document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''}" /><input name="unitId" value="@Model.UnitId" /><input name="ownerId" value="${button.dataset.ownerId}" /><input name="ownershipPercentage" value="100" /><input name="validFrom" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />`; document.body.appendChild(form); form.submit(); }));
});
</script>
