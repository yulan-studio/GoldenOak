@model Web.Models.CreateOwnerForUnitViewModel
@{ ViewData["Title"] = "新增业主"; }
<div class="go-page-header"><div><div class="go-eyebrow">@Model.BuildingName · 单元 @Model.UnitNumber</div><h1 class="go-page-title">新增业主</h1><div class="go-page-subtitle">可以搜索已有业主，也可以创建新的业主资料。</div></div><div class="go-header-actions"><a class="go-btn-back" asp-controller="Units" asp-action="Owners" asp-route-id="@Model.UnitId">← 返回业主</a></div></div>
<section class="go-panel mb-4"><h2 class="go-panel-title">搜索已有业主</h2><p class="text-muted">请输入姓名、Email 或电话号码。确认后只会建立当前单元的关联，不会重复创建用户账户。</p><div class="go-search-row"><input id="ownerSearchTerm" class="form-control" placeholder="姓名、Email 或电话" /><button id="ownerSearchButton" class="go-btn-primary" type="button">搜索</button></div><div id="ownerSearchResults" class="go-search-results"></div></section>
<section class="go-panel"><h2 class="go-panel-title">创建新业主</h2><form asp-action="CreateOwner" method="post" class="go-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="UnitId" type="hidden" /><div class="go-form-grid"><div><label asp-for="FullName">姓名</label><input asp-for="FullName" class="form-control" /></div><div><label asp-for="Email">Email</label><input asp-for="Email" class="form-control" type="email" /></div><div><label asp-for="PhoneNumber">电话</label><input asp-for="PhoneNumber" class="form-control" /></div><div><label asp-for="MailingAddress">邮寄地址</label><input asp-for="MailingAddress" class="form-control" /></div><div><label asp-for="OwnershipPercentage">产权比例</label><input asp-for="OwnershipPercentage" class="form-control" type="number" min="0.01" max="100" step="0.01" /></div><div><label asp-for="ValidFrom">生效日期</label><input asp-for="ValidFrom" class="form-control" type="date" /></div><div><label asp-for="PayoutPreference">付款方式</label><select asp-for="PayoutPreference" class="form-select"><option value="BANK_TRANSFER">Bank Transfer</option><option value="CHEQUE">Cheque</option><option value="E_TRANSFER">E-Transfer</option></select></div></div><div class="go-form-actions"><button class="go-btn-primary" type="submit">保存并关联业主</button><a class="go-btn-back" asp-controller="Units" asp-action="Owners" asp-route-id="@Model.UnitId">取消</a></div></form></section>
<script>
document.getElementById('ownerSearchButton').addEventListener('click', async function () {
    const term = document.getElementById('ownerSearchTerm').value.trim();
    const results = document.getElementById('ownerSearchResults');
    if (!term) { results.innerHTML = '<div class="text-muted mt-3">请输入搜索内容。</div>'; return; }
    results.innerHTML = '<div class="text-muted mt-3">正在搜索…</div>';
    const response = await fetch('@Url.Action("SearchOwners", "Units")?unitId=@Model.UnitId&term=' + encodeURIComponent(term));
    const owners = await response.json();
    if (!owners.length) { results.innerHTML = '<div class="text-muted mt-3">没有找到匹配的业主。你可以在下面创建新业主。</div>'; return; }
    results.innerHTML = owners.map(owner => `<div class="go-search-result"><div><strong>${owner.fullName}</strong><div class="text-muted small">${owner.email ?? ''} · ${owner.phoneNumber ?? ''} · 已关联 ${owner.unitCount} 个单元</div></div><button class="go-btn-secondary" type="button" ${owner.isAlreadyLinked ? 'disabled' : `data-owner-id="${owner.ownerId}"`}>${owner.isAlreadyLinked ? '@L["AlreadyLinked"]' : '@L["SelectOwner"]'}</button></div>`).join('');
    results.querySelectorAll('[data-owner-id]').forEach(button => button.addEventListener('click', () => {
        const form = document.createElement('form'); form.method = 'post'; form.action = '@Url.Action("AddExistingOwner", "Units")';
        form.innerHTML = `<input name="__RequestVerificationToken" value="${document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''}" /><input name="unitId" value="@Model.UnitId" /><input name="ownerId" value="${button.dataset.ownerId}" /><input name="ownershipPercentage" value="100" /><input name="validFrom" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />`;
        document.body.appendChild(form); form.submit();
    }));
});
</script>
