@model Web.Models.Unit
<form method="post" class="go-panel go-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="UnitId" type="hidden" /><input asp-for="BuildingId" type="hidden" />
    <div class="go-form-grid">
        <div><label asp-for="UnitNumber"></label><input asp-for="UnitNumber" class="form-control" /></div>
        <div><label asp-for="Bedrooms"></label><input asp-for="Bedrooms" class="form-control" type="number" step="0.5" min="0" /></div>
        <div><label asp-for="Bathrooms"></label><input asp-for="Bathrooms" class="form-control" type="number" step="0.5" min="0" /></div>
        <div><label asp-for="SizeSqft"></label><input asp-for="SizeSqft" class="form-control" type="number" step="0.01" min="0" /></div>
        <div><label asp-for="AskingRent"></label><input asp-for="AskingRent" class="form-control" type="number" step="0.01" min="0" /></div>
        <div><label>@L["Status"]</label><select asp-for="Status" class="form-select"><option value="AVAILABLE">@L["Available"]</option><option value="OCCUPIED">@L["Occupied"]</option><option value="UNAVAILABLE">@L["Unavailable"]</option><option value="ARCHIVED">@L["Archived"]</option></select></div>
    </div>
    <div class="go-form-actions"><button class="go-btn-primary" type="submit">@L["Save"]</button><a class="go-btn-secondary" asp-controller="Buildings" asp-action="Units" asp-route-id="@Model.BuildingId">@L["Cancel"]</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
