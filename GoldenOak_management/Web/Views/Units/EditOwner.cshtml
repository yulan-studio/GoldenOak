@model Web.Models.EditOwnerForUnitViewModel
@{ ViewData["Title"] = "编辑业主"; }
<div class="go-page-header"><div><div class="go-eyebrow">@Model.BuildingName · Unit @Model.UnitNumber</div><h1 class="go-page-title">编辑业主</h1><div class="go-page-subtitle">修改 Owner 资料和该 Unit 的产权信息。</div></div><div class="go-header-actions"><a class="go-btn-back" asp-controller="Units" asp-action="Owners" asp-route-id="@Model.UnitId">← 返回业主</a></div></div>
<form asp-action="EditOwner" method="post" class="go-panel go-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="UnitOwnerId" type="hidden" /><input asp-for="UnitId" type="hidden" /><div class="go-form-grid"><div><label asp-for="FullName">姓名</label><input asp-for="FullName" class="form-control" /></div><div><label asp-for="Email">Email</label><input asp-for="Email" class="form-control" type="email" /></div><div><label asp-for="PhoneNumber">电话</label><input asp-for="PhoneNumber" class="form-control" /></div><div><label asp-for="MailingAddress">邮寄地址</label><input asp-for="MailingAddress" class="form-control" /></div><div><label asp-for="OwnershipPercentage">产权比例</label><input asp-for="OwnershipPercentage" class="form-control" type="number" min="0.01" max="100" step="0.01" /></div><div><label asp-for="ValidFrom">生效日期</label><input asp-for="ValidFrom" class="form-control" type="date" /></div><div><label asp-for="PayoutPreference">付款方式</label><select asp-for="PayoutPreference" class="form-select"><option value="BANK_TRANSFER">Bank Transfer</option><option value="CHEQUE">Cheque</option><option value="E_TRANSFER">E-Transfer</option></select></div></div><div class="go-form-actions"><button class="go-btn-primary" type="submit">保存修改</button><a class="go-btn-back" asp-controller="Units" asp-action="Owners" asp-route-id="@Model.UnitId">取消</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
