@model Web.Models.EditOwnerForUnitViewModel
@{ ViewData["Title"] = L["EditOwner"]; }
<div class="go-page-header"><div><div class="go-eyebrow">@Model.BuildingName · @L["Unit"] @Model.UnitNumber</div><h1 class="go-page-title">@L["EditOwner"]</h1><div class="go-page-subtitle">@L["OwnerInfoHint"]</div></div><div class="go-header-actions"><a class="go-btn-back" asp-controller="Units" asp-action="Owners" asp-route-id="@Model.UnitId">← @L["BackToOwners"]</a></div></div>
<form asp-action="EditOwner" method="post" class="go-panel go-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="UnitOwnerId" type="hidden" /><input asp-for="UnitId" type="hidden" /><div class="go-form-grid"><div><label asp-for="FullName">@L["Name"]</label><input asp-for="FullName" class="form-control" /></div><div><label asp-for="Email">@L["Email"]</label><input asp-for="Email" class="form-control" type="email" /></div><div><label asp-for="PhoneNumber">@L["Phone"]</label><input asp-for="PhoneNumber" class="form-control" /></div><div><label asp-for="MailingAddress">@L["MailingAddress"]</label><input asp-for="MailingAddress" class="form-control" /></div><div><label asp-for="OwnershipPercentage">@L["OwnershipPercentage"]</label><input asp-for="OwnershipPercentage" class="form-control" type="number" min="0.01" max="100" step="0.01" /></div><div><label asp-for="ValidFrom">@L["EffectiveDate"]</label><input asp-for="ValidFrom" class="form-control" type="date" /></div><div><label asp-for="BankName">@L["BankName"]</label><input asp-for="BankName" class="form-control" /></div><div><label asp-for="AccountHolderName">@L["AccountHolderName"]</label><input asp-for="AccountHolderName" class="form-control" /></div><div><label asp-for="AccountLastFour">@L["AccountLastFour"]</label><input asp-for="AccountLastFour" class="form-control" maxlength="4" inputmode="numeric" /></div><div><label asp-for="PayoutPreference">@L["PayoutPreference"]</label><select asp-for="PayoutPreference" class="form-select"><option value="BANK_TRANSFER">Bank Transfer</option><option value="CHEQUE">Cheque</option><option value="E_TRANSFER">E-Transfer</option></select></div><div><label><input asp-for="IsPrimaryPayoutOwner" /> @L["PrimaryPayoutOwner"]</label></div></div><div class="go-form-actions"><button class="go-btn-primary" type="submit">@L["SaveChanges"]</button><a class="go-btn-back" asp-controller="Units" asp-action="Owners" asp-route-id="@Model.UnitId">@L["Cancel"]</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
