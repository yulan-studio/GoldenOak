@model Web.Models.UnitOwnerViewModel
@{ ViewData["Title"] = L["Owner"]; }
<div class="go-page-header"><div><div class="go-eyebrow">@Model.BuildingName · @L["Unit"] @Model.UnitNumber</div><h1 class="go-page-title">@L["Owner"]</h1><div class="go-page-subtitle">@L["OwnerRelationshipHint"]</div></div><div class="go-header-actions"><a class="go-btn-back" asp-controller="Buildings" asp-action="Units" asp-route-id="@Model.BuildingId">← @L["BackToUnits"]</a><a class="go-btn-primary" asp-controller="Units" asp-action="CreateOwner" asp-route-unitId="@Model.UnitId">＋ @L["AddOwner"]</a></div></div>
<section class="go-panel"><table class="go-table"><thead><tr><th>@L["Name"]</th><th>@L["Email"]</th><th>@L["OwnershipPercentage"]</th><th>@L["PrimaryOwner"]</th><th>@L["ValidFrom"]</th><th>@L["ValidTo"]</th><th>@L["Actions"]</th></tr></thead><tbody>@if (Model.Owners.Count == 0) { <tr><td colspan="7" class="text-muted">@L["NoOwnerRelationship"]</td></tr> } else { foreach (var owner in Model.Owners) { <tr><td><strong>@owner.FullName</strong></td><td>@owner.Email</td><td>@owner.OwnershipPercentage%</td><td>@(owner.IsPrimaryPayoutOwner ? "Yes" : "No")</td><td>@owner.ValidFrom</td><td>@(owner.ValidTo?.ToString() ?? "—")</td><td class="go-actions"><a asp-controller="Units" asp-action="EditOwner" asp-route-id="@owner.UnitOwnerId">@L["Edit"]</a><form asp-action="DeleteOwner" method="post"><input type="hidden" name="id" value="@owner.UnitOwnerId" /><input type="hidden" name="unitId" value="@Model.UnitId" /><button class="go-link-button" type="submit">@L["RemoveAssociation"]</button></form></td></tr> } }</tbody></table></section>
