@model Web.Models.UnitOwnerViewModel
@{ ViewData["Title"] = L["Owner"]; }
<div class="go-page-header"><div><div class="go-eyebrow">@Model.BuildingName · Unit @Model.UnitNumber</div><h1 class="go-page-title">@L["Owner"]</h1><div class="go-page-subtitle">查看和管理该单元对应的业主和产权比例。</div></div><div class="go-header-actions"><a class="go-btn-back" asp-controller="Buildings" asp-action="Units" asp-route-id="@Model.BuildingId">← 返回单元</a><a class="go-btn-primary" asp-controller="Units" asp-action="CreateOwner" asp-route-unitId="@Model.UnitId">＋ 新增业主</a></div></div>
<section class="go-panel"><table class="go-table"><thead><tr><th>姓名</th><th>Email</th><th>产权比例</th><th>有效开始</th><th>有效结束</th><th>操作</th></tr></thead><tbody>@if (Model.Owners.Count == 0) { <tr><td colspan="6" class="text-muted">尚未建立 Owner 关系。</td></tr> } else { foreach (var owner in Model.Owners) { <tr><td><strong>@owner.FullName</strong></td><td>@owner.Email</td><td>@owner.OwnershipPercentage%</td><td>@owner.ValidFrom</td><td>@(owner.ValidTo?.ToString() ?? "—")</td><td class="go-actions"><a asp-controller="Units" asp-action="EditOwner" asp-route-id="@owner.UnitOwnerId">编辑</a><form asp-action="DeleteOwner" method="post"><input type="hidden" name="id" value="@owner.UnitOwnerId" /><input type="hidden" name="unitId" value="@Model.UnitId" /><button class="go-link-button" type="submit">删除关联</button></form></td></tr> } }</tbody></table></section>
