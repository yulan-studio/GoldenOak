@model List<Web.Models.RenterProfile>
@{ ViewData["Title"] = "租客管理"; }
<div class="go-page-header"><div><div class="go-eyebrow">租约管理</div><h1 class="go-page-title">租客管理</h1><div class="go-page-subtitle">管理租客资料和账号状态</div></div><div class="go-header-actions"><a class="go-btn-primary" asp-action="Create">＋ 添加租客</a></div></div>
<section class="go-panel"><div class="table-responsive"><table class="go-table"><thead><tr><th>姓名</th><th>User ID</th><th>出生日期</th><th>状态</th><th>操作</th></tr></thead><tbody>@foreach (var renter in Model) { <tr><td>@renter.FullName</td><td>@renter.UserId</td><td>@(renter.DateOfBirth?.ToString() ?? "—")</td><td>@(renter.ArchivedAt.HasValue ? "已归档" : "正常")</td><td><a asp-action="Edit" asp-route-id="@renter.UserId">编辑</a>@if (!renter.ArchivedAt.HasValue) { <form asp-action="Archive" method="post" style="display:inline"><input type="hidden" name="id" value="@renter.UserId" /><button class="go-link-button" type="submit">归档</button></form> }</td></tr> }</tbody></table></div></section>
