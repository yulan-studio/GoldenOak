@model List<Web.Models.RenterProfile>
@{ ViewData["Title"] = "租客管理"; }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="go-page-header"><div><div class="go-eyebrow">租约管理</div><h1 class="go-page-title">租客管理</h1><div class="go-page-subtitle">管理租客资料和账号状态</div></div><div class="go-header-actions"><a class="go-btn-primary" asp-action="Create">＋ 添加租客</a></div></div>
<section class="go-panel"><div class="table-responsive"><table class="go-table"><thead><tr><th>姓名</th><th>User ID</th><th>出生日期</th><th>状态</th><th>操作</th></tr></thead><tbody>@foreach (var renter in Model) { <tr><td>@renter.FullName</td><td>@renter.UserId</td><td>@(renter.DateOfBirth?.ToString() ?? "—")</td><td>@(renter.ArchivedAt.HasValue ? "已归档" : "正常")</td><td><a asp-action="Edit" asp-route-id="@renter.UserId">编辑</a>@if (!renter.ArchivedAt.HasValue) { <form asp-action="Archive" method="post" style="display:inline"><input type="hidden" name="id" value="@renter.UserId" /><button class="go-link-button" type="submit">归档</button></form> }<button type="button" class="go-link-button go-delete-link" data-bs-toggle="modal" data-bs-target="#delete-renter-@renter.UserId">删除</button><div class="modal fade go-confirm-modal" id="delete-renter-@renter.UserId" tabindex="-1" aria-labelledby="delete-renter-title-@renter.UserId" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><div class="go-modal-eyebrow">租客管理</div><h2 class="modal-title" id="delete-renter-title-@renter.UserId">删除租客</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div><div class="modal-body"><div class="go-confirm-icon">!</div><p>确定要删除租客 <strong>@renter.FullName</strong> 吗？</p><p class="text-muted small">删除后将无法恢复。只有未关联任何租约的租客才能被删除。</p></div><div class="modal-footer"><button type="button" class="go-btn-secondary" data-bs-dismiss="modal">取消</button><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@renter.UserId" />@Html.AntiForgeryToken()<button class="go-btn-danger" type="submit">确认删除</button></form></div></div></div></div></td></tr> }</tbody></table></div></section>
