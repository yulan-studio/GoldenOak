@model Web.Models.CreateRenterViewModel
@{ ViewData["Title"] = "添加租客"; }
<div class="go-page-header"><div><div class="go-eyebrow">租客管理</div><h1 class="go-page-title">添加租客</h1></div><div class="go-header-actions"><a class="go-btn-back" asp-action="Index">返回租客列表</a></div></div>
<form asp-action="Create" method="post" class="go-panel go-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="go-form-grid"><div><label asp-for="FullName">姓名</label><input asp-for="FullName" class="form-control" /></div><div><label asp-for="Email">邮箱</label><input asp-for="Email" class="form-control" /></div><div><label asp-for="PhoneNumber">电话</label><input asp-for="PhoneNumber" class="form-control" /></div><div><label asp-for="DateOfBirth">出生日期</label><input asp-for="DateOfBirth" class="form-control" type="date" /></div><div><label asp-for="EmergencyContactName">紧急联系人</label><input asp-for="EmergencyContactName" class="form-control" /></div><div><label asp-for="EmergencyContactPhone">紧急联系人电话</label><input asp-for="EmergencyContactPhone" class="form-control" /></div></div><div class="go-form-actions"><button class="go-btn-primary" type="submit">保存租客</button><a class="go-btn-secondary" asp-action="Index">取消</a></div></form>
