@model Web.Models.CreateRenterViewModel
@{ ViewData["Title"] = L["AddRenter"]; }
<div class="go-page-header"><div><div class="go-eyebrow">@L["RenterManagement"]</div><h1 class="go-page-title">@L["AddRenter"]</h1></div><div class="go-header-actions"><a class="go-btn-back" asp-action="Index">@L["ReturnToRenterList"]</a></div></div>
<form asp-action="Create" method="post" class="go-panel go-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="go-form-grid"><div><label asp-for="FullName">@L["Name"]</label><input asp-for="FullName" class="form-control" /></div><div><label asp-for="Email">@L["Email"]</label><input asp-for="Email" class="form-control" /></div><div><label asp-for="PhoneNumber">@L["Phone"]</label><input asp-for="PhoneNumber" class="form-control" /></div><div><label asp-for="DateOfBirth">@L["DateOfBirth"]</label><input asp-for="DateOfBirth" class="form-control" type="date" /></div><div><label asp-for="EmergencyContactName">@L["EmergencyContact"]</label><input asp-for="EmergencyContactName" class="form-control" /></div><div><label asp-for="EmergencyContactPhone">@L["EmergencyContactPhone"]</label><input asp-for="EmergencyContactPhone" class="form-control" /></div></div><div class="go-form-actions"><button class="go-btn-primary" type="submit">@L["SaveRenter"]</button><a class="go-btn-secondary" asp-action="Index">@L["Cancel"]</a></div></form>
