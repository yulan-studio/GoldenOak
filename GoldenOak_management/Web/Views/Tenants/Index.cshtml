@model List<Web.Models.RenterProfile>
@{ ViewData["Title"] = L["RenterManagement"]; var contacts = (IReadOnlyDictionary<long, Web.Models.ApplicationUser>)ViewBag.RenterContacts; }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="go-page-header"><div><div class="go-eyebrow">@L["RenterManagement"]</div><h1 class="go-page-title">@L["RenterManagement"]</h1><div class="go-page-subtitle">@L["ManageRenterProfiles"]</div></div><div class="go-header-actions"><a class="go-btn-primary" asp-action="Create">＋ @L["AddRenter"]</a></div></div>
<section class="go-panel"><div class="table-responsive"><table class="go-table"><thead><tr><th>@L["Name"]</th><th>@L["Email"]</th><th>@L["Phone"]</th><th>@L["DateOfBirth"]</th><th>@L["Status"]</th><th>@L["Actions"]</th></tr></thead><tbody>@foreach (var renter in Model) { contacts.TryGetValue(renter.UserId, out var contact); <tr><td>@renter.FullName</td><td>@(contact?.Email ?? "—")</td><td>@(contact?.PhoneNumber ?? "—")</td><td>@(renter.DateOfBirth?.ToString() ?? "—")</td><td>@(renter.ArchivedAt.HasValue ? L["Archived"] : L["Normal"])</td><td><a asp-action="Edit" asp-route-id="@renter.UserId">@L["Edit"]</a>@if (!renter.ArchivedAt.HasValue) { <form asp-action="Archive" method="post" style="display:inline"><input type="hidden" name="id" value="@renter.UserId" /><button class="go-link-button" type="submit">@L["Archive"]</button></form> }<button type="button" class="go-link-button go-delete-link" data-bs-toggle="modal" data-bs-target="#delete-renter-@renter.UserId">@L["Delete"]</button><div class="modal fade go-confirm-modal" id="delete-renter-@renter.UserId" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><div class="go-modal-eyebrow">@L["RenterManagement"]</div><h2 class="modal-title">@L["DeleteRenter"]</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Cancel"]"></button></div><div class="modal-body"><div class="go-confirm-icon">!</div><p>@L["ConfirmDeleteRenter"] <strong>@renter.FullName</strong>?</p><p class="text-muted small">@L["DeleteRenterWarning"]</p></div><div class="modal-footer"><button type="button" class="go-btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@renter.UserId" />@Html.AntiForgeryToken()<button class="go-btn-danger" type="submit">@L["ConfirmDelete"]</button></form></div></div></div></div></td></tr> }</tbody></table></div></section>
