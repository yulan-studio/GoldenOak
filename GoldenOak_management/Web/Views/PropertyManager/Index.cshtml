@model Web.Models.PropertyManagerDashboardViewModel
@{ ViewData["Title"] = L["PropertyManagerHome"]; }
<div class="go-page-header"><div><div class="go-eyebrow">@L["PropertyManagerWorkspace"]</div><h1 class="go-page-title">@L["PropertyManagerHome"]</h1><div class="go-page-subtitle">@L["PropertyManagerHomeDescription"]</div></div></div>
<div class="go-card-grid"><div class="go-card"><div class="text-muted small mb-2">@L["ManagedBuildings"]</div><div class="h3 mb-1">@Model.BuildingCount</div><span class="go-status go-status-info">@Model.OwnerCount @L["Owner"]</span></div><div class="go-card"><div class="text-muted small mb-2">@L["ManagedUnits"]</div><div class="h3 mb-1">@Model.UnitCount</div><span class="go-status go-status-success">@Model.OccupiedUnitCount @L["Occupied"]</span></div><div class="go-card"><div class="text-muted small mb-2">@L["AvailableUnits"]</div><div class="h3 mb-1">@Model.AvailableUnitCount</div><span class="go-status go-status-success">@L["CanBeListed"]</span></div></div>
<section class="go-panel"><h2 class="go-panel-title">@L["ManagedBuildings"]</h2><div class="table-responsive"><table class="go-table"><thead><tr><th>@L["BuildingsTitle"]</th><th>@L["Address"]</th><th>@L["UnitCount"]</th><th>@L["Occupied"]</th><th>@L["Status"]</th></tr></thead><tbody>@foreach (var building in Model.Buildings) { <tr><td>@building.Name</td><td>@building.Address</td><td>@building.UnitCount</td><td>@building.OccupiedCount</td><td>@building.Status</td></tr> }</tbody></table></div></section>
