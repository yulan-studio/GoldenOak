                    <tr><td>28 Oak Ave #304</td><td>Michael Lee</td><td>2026-10</td><td>$2,180</td><td><span class="go-status go-status-warning">部分支付</span></td></tr>
                    <tr><td>7 Maple Rd #2</td><td>Emily Wong</td><td>2026-10</td><td>$1,960</td><td><span class="go-status go-status-danger">逾期 34 天</span></td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="go-panel">
        <h2 class="go-panel-title">需要关注</h2>
        <div class="border-bottom py-3"><strong>3 个报表等待发布</strong><div class="text-muted small mt-1">PM 已审核，等待 Admin release</div></div>
