@model Web.Models.PropertyManagerDashboardViewModel
@{
    ViewData["Title"] = "物业经理首页";
}

<div class="go-page-header">
    <div>
        <div class="go-eyebrow">Property Manager Workspace</div>
        <h1 class="go-page-title">早上好，Golden Oak</h1>
        <div class="go-page-subtitle">这里是您当前管理的楼宇和单元概况。</div>
    </div>
    <button class="go-btn-primary" type="button">＋ 创建月度报表</button>
</div>

<div class="go-card-grid">
    <div class="go-card"><div class="text-muted small mb-2">管理中的楼宇</div><div class="h3 mb-1">@Model.BuildingCount</div><span class="go-status go-status-info">@Model.OwnerCount 位业主</span></div>
    <div class="go-card"><div class="text-muted small mb-2">管理中的单元</div><div class="h3 mb-1">@Model.UnitCount</div><span class="go-status go-status-success">@Model.OccupiedUnitCount 个已入住</span></div>
    <div class="go-card"><div class="text-muted small mb-2">可出租单元</div><div class="h3 mb-1">@Model.AvailableUnitCount</div><span class="go-status go-status-success">可安排出租</span></div>
    <div class="go-card"><div class="text-muted small mb-2">租客档案</div><div class="h3 mb-1">@Model.RenterCount</div><span class="go-status go-status-warning">@Model.UnavailableUnitCount 个单元暂不可用</span></div>
</div>

<div class="go-panel-grid">
    <section class="go-panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="go-panel-title mb-0">管理中的楼宇</h2>
            <span class="text-muted small">实时数据库数据</span>
        </div>
        <div class="table-responsive">
            <table class="go-table">
                <thead><tr><th>楼宇</th><th>地址</th><th>单元数</th><th>已入住</th><th>状态</th></tr></thead>
                <tbody>
                    @foreach (var building in Model.Buildings)
                    {
                        <tr><td>@building.Name</td><td>@building.Address</td><td>@building.UnitCount</td><td>@building.OccupiedCount</td><td><span class="go-status go-status-success">@building.Status</span></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="go-panel">
        <h2 class="go-panel-title">物业经理快捷入口</h2>
        <div class="border-bottom py-3"><strong>查看全部楼宇</strong><div class="text-muted small mt-1">查看楼宇、单元和当前状态</div></div>
        <div class="border-bottom py-3"><strong>检查可出租单元</strong><div class="text-muted small mt-1">当前有 @Model.AvailableUnitCount 个单元可安排出租</div></div>
        <div class="border-bottom py-3"><strong>查看租客档案</strong><div class="text-muted small mt-1">当前有 @Model.RenterCount 个租客档案</div></div>
        <div class="py-3"><strong>准备后续租金模块</strong><div class="text-muted small mt-1">下一步可接入 Rent Charges 和 Rent Payments</div></div>
    </section>
</div>
