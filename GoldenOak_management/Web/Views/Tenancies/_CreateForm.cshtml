@model Web.Models.CreateTenancyViewModel
<form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger"></div><div><label asp-for="UnitId">房源 ID</label><input asp-for="UnitId" type="number" /></div><div><label asp-for="LeaseStartDate">开始日期</label><input asp-for="LeaseStartDate" type="date" /></div><div><label asp-for="LeaseEndDate">结束日期</label><input asp-for="LeaseEndDate" type="date" /></div><div><label asp-for="MonthlyRent">月租金</label><input asp-for="MonthlyRent" type="number" min="0" step="0.01" /></div><div><label asp-for="DepositAmount">押金</label><input asp-for="DepositAmount" type="number" min="0" step="0.01" /></div><div><label asp-for="DepositReceivedDate">押金收取日期</label><input asp-for="DepositReceivedDate" type="date" /></div><div><label asp-for="PrimaryRenterId">主租客 ID</label><input asp-for="PrimaryRenterId" type="number" min="1" /></div><button class="go-btn-primary" type="submit">保存</button><a asp-action="Index">取消</a></form>
