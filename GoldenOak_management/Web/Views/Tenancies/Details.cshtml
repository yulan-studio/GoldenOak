@model Web.Models.Tenancy
@{ ViewData["Title"] = "租约详情"; var allowedStatuses = Model.Status switch { "PENDING" => new[] { "ACTIVE", "CANCELLED" }, "ACTIVE" => new[] { "ENDED", "TERMINATED" }, _ => Array.Empty<string>() }; }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@Html.AntiForgeryToken()
<script>document.addEventListener('DOMContentLoaded',function(){const token=document.querySelector('input[name="__RequestVerificationToken"]');const form=document.querySelector('#add-renter-modal form');if(token&&form)form.appendChild(token.cloneNode(true));});</script>
<script>document.addEventListener('DOMContentLoaded',function(){const link=document.querySelector('a[href*="AddRenter"]');if(!link)return;const id=new URL(link.href).searchParams.get('id')||link.href.split('/').pop();const modal=document.createElement('div');modal.innerHTML='<div class="modal fade" id="add-renter-modal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">添加租客</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form method="post" action="/Tenancies/AddRenter"><div class="modal-body"><input type="hidden" name="id" value="'+id+'"/><div class="mb-3"><label class="form-label">租客 User ID</label><input class="form-control" name="renterId" type="number" min="1" required/></div><label><input name="isPrimary" type="checkbox" value="true"/> 设为主租客</label></div><div class="modal-footer"><button type="button" class="go-btn-secondary" data-bs-dismiss="modal">取消</button><button class="go-btn-primary" type="submit">添加租客</button></div></form></div></div></div>';document.body.appendChild(modal);link.removeAttribute('href');link.setAttribute('href','#add-renter-modal');link.setAttribute('data-bs-toggle','modal');});</script>
<div class="go-page-header"><div><div class="go-eyebrow">租约管理</div><h1 class="go-page-title">租约详情</h1><div class="go-page-subtitle">房源：@Model.Unit.UnitNumber</div></div><div class="go-header-actions"><a class="go-btn-back" asp-action="Index">返回租约列表</a>@if (User.IsInRole("ADMIN") || User.IsInRole("PROPERTY_MANAGER")) { <a class="go-btn-primary" asp-action="Edit" asp-route-id="@Model.TenancyId">编辑</a><a class="go-btn-back" asp-action="AddRenter" asp-route-id="@Model.TenancyId">添加租客</a> }</div></div>
<section class="go-panel"><div class="go-form-grid"><div><label>租期</label><p>@Model.LeaseStartDate 至 @Model.LeaseEndDate</p></div><div><label>月租金</label><p>@Model.MonthlyRent.ToString("C2")</p></div><div><label>押金</label><p>@Model.DepositAmount.ToString("C2")</p></div><div><label>当前状态</label><p><span class="go-status go-status-info">@Model.Status</span></p></div></div>@if (User.IsInRole("ADMIN") || User.IsInRole("PROPERTY_MANAGER")) { <form asp-action="ChangeStatus" method="post" class="go-form-actions mt-3"><input type="hidden" name="id" value="@Model.TenancyId" /><select name="status" class="form-select" style="max-width:220px"><option value="">选择状态</option>@foreach (var status in allowedStatuses) { <option value="@status">@status</option> }</select>@if (allowedStatuses.Length > 0) { <button class="go-btn-primary" type="submit">修改状态</button> } else { <span class="text-muted">当前状态没有可用的后续状态</span> }</form> }<h2>租客信息</h2><div class="table-responsive"><table class="go-table"><thead><tr><th>租客 ID</th><th>邮箱</th><th>主租客</th><th>添加时间</th><th>操作</th></tr></thead><tbody>@foreach (var renter in Model.Renters) { <tr><td>@renter.RenterId</td><td>@(renter.Renter.Email ?? "—")</td><td>@(renter.IsPrimary ? "是" : "否")</td><td>@renter.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@if (User.IsInRole("ADMIN") || User.IsInRole("PROPERTY_MANAGER")) { <form asp-action="RemoveRenter" method="post"><input type="hidden" name="id" value="@Model.TenancyId" /><input type="hidden" name="renterId" value="@renter.RenterId" /><button class="go-link-button" type="submit">移除</button></form> }</td></tr> }</tbody></table></div></section>
