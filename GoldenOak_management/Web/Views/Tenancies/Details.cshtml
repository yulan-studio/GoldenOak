@model Web.Models.Tenancy
@{ ViewData["Title"] = "租约详情"; var allowedStatuses = Model.Status switch { "PENDING" => new[] { "ACTIVE", "CANCELLED" }, "ACTIVE" => new[] { "ENDED", "TERMINATED" }, _ => Array.Empty<string>() }; var renterProfiles = (IReadOnlyDictionary<long, Web.Models.RenterProfile>)ViewBag.RenterProfiles; }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@Html.AntiForgeryToken()
<partial name="_OwnerInfo" model="ViewBag.UnitOwners" />
<script>document.addEventListener('DOMContentLoaded',function(){const owner=document.getElementById('owner-info');const main=[...document.querySelectorAll('.go-panel')].find(x=>x.id!=='owner-info');if(owner&&main)main.after(owner);});</script>
<script>document.addEventListener('DOMContentLoaded',function(){const token=document.querySelector('input[name="__RequestVerificationToken"]');const form=document.querySelector('#add-renter-modal form');if(token&&form)form.appendChild(token.cloneNode(true));});</script>
<script>document.addEventListener('DOMContentLoaded',function(){const link=document.querySelector('a[href*="AddRenter"]');if(!link)return;const id=new URL(link.href).searchParams.get('id')||link.href.split('/').pop();const modal=document.createElement('div');modal.innerHTML='<div class="modal fade" id="add-renter-modal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">添加租客</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form method="post" action="/Tenancies/AddRenter"><div class="modal-body"><input type="hidden" name="id" value="'+id+'"/><div class="mb-3"><label class="form-label">租客 User ID</label><input class="form-control" name="renterId" type="number" min="1" required/></div><label><input name="isPrimary" type="checkbox" value="true"/> 设为主租客</label></div><div class="modal-footer"><button type="button" class="go-btn-secondary" data-bs-dismiss="modal">取消</button><button class="go-btn-primary" type="submit">添加租客</button></div></form></div></div></div>';document.body.appendChild(modal);link.removeAttribute('href');link.setAttribute('href','#add-renter-modal');link.setAttribute('data-bs-toggle','modal');});</script>
<script>document.addEventListener('DOMContentLoaded',function(){const modal=document.querySelector('#add-renter-modal');if(!modal)return;const id='@Model.TenancyId';const token=document.querySelector('input[name="__RequestVerificationToken"]');modal.querySelector('.modal-content').innerHTML='<div class="modal-header"><h5 class="modal-title">添加租客</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><ul class="nav nav-tabs mb-3"><li class="nav-item"><button class="nav-link active" type="button" id="search-tab">搜索已有租客</button></li><li class="nav-item"><button class="nav-link" type="button" id="create-tab">快速创建租客</button></li></ul><div id="search-pane"><input id="renter-search" class="form-control mb-2" placeholder="姓名、邮箱或电话"/><div id="renter-results"></div></div><div id="create-pane" hidden><form method="post" action="/Tenancies/QuickCreateRenter"><input type="hidden" name="id" value="'+id+'"/><div class="go-form-grid"><input class="form-control" name="FullName" placeholder="姓名" required/><input class="form-control" name="Email" type="email" placeholder="邮箱" required/><input class="form-control" name="PhoneNumber" placeholder="电话"/></div><label class="mt-2"><input name="isPrimary" type="checkbox" value="true" checked/> 设为主租客</label><div class="modal-footer px-0"><button class="go-btn-primary" type="submit">创建并添加</button></div></form></div></div>';if(token)modal.querySelectorAll('form').forEach(f=>f.appendChild(token.cloneNode(true)));const search=modal.querySelector('#renter-search'),results=modal.querySelector('#renter-results');search.addEventListener('input',async()=>{if(search.value.trim().length<2){results.innerHTML='';return;}const data=await fetch('/Renters/Search?term='+encodeURIComponent(search.value)).then(r=>r.json());results.innerHTML=data.map(x=>'<form method="post" action="/Tenancies/AddRenter" class="border-bottom py-2"><input type="hidden" name="id" value="'+id+'"/><input type="hidden" name="renterId" value="'+x.userId+'"/><button class="btn btn-link p-0" type="submit">'+x.fullName+' — '+(x.email||'')+'</button><label class="ms-2"><input name="isPrimary" type="checkbox" value="true"/> 主租客</label></form>').join('');if(token)results.querySelectorAll('form').forEach(f=>f.appendChild(token.cloneNode(true)));});modal.querySelector('#search-tab').onclick=()=>{modal.querySelector('#search-pane').hidden=false;modal.querySelector('#create-pane').hidden=true;};modal.querySelector('#create-tab').onclick=()=>{modal.querySelector('#search-pane').hidden=true;modal.querySelector('#create-pane').hidden=false;};});</script>
<div class="go-page-header"><div><div class="go-eyebrow">租约管理</div><h1 class="go-page-title">租约详情</h1><div class="go-page-subtitle">房源：@Model.Unit.UnitNumber</div></div><div class="go-header-actions"><a class="go-btn-back" asp-action="Index">返回租约列表</a>@if (User.IsInRole("ADMIN") || User.IsInRole("PROPERTY_MANAGER")) { <a class="go-btn-primary" asp-action="Edit" asp-route-id="@Model.TenancyId">编辑</a><a class="go-btn-back" asp-action="AddRenter" asp-route-id="@Model.TenancyId">添加租客</a> }</div></div>
<section class="go-panel"><div class="go-form-grid"><div><label>租期</label><p>@Model.LeaseStartDate 至 @Model.LeaseEndDate</p></div><div><label>月租金</label><p>@Model.MonthlyRent.ToString("C2")</p></div><div><label>押金</label><p>@Model.DepositAmount.ToString("C2")</p></div><div><label>当前状态</label><p><span class="go-status go-status-info">@Model.Status</span></p></div></div>@if (User.IsInRole("ADMIN") || User.IsInRole("PROPERTY_MANAGER")) { <form asp-action="ChangeStatus" method="post" class="go-form-actions mt-3"><input type="hidden" name="id" value="@Model.TenancyId" /><select name="status" class="form-select" style="max-width:220px"><option value="">选择状态</option>@foreach (var status in allowedStatuses) { <option value="@status">@status</option> }</select>@if (allowedStatuses.Length > 0) { <button class="go-btn-primary" type="submit">修改状态</button> } else { <span class="text-muted">当前状态没有可用的后续状态</span> }</form> }<h2>租客信息</h2><div class="table-responsive"><table class="go-table"><thead><tr><th>租客姓名</th><th>电话号码</th><th>主租客</th><th>操作</th></tr></thead><tbody>@foreach (var renter in Model.Renters) { <tr><td>@(renterProfiles.TryGetValue(renter.RenterId, out var profile) ? profile.FullName : "—")</td><td>@(renter.Renter.PhoneNumber ?? "—")</td><td>@(renter.IsPrimary ? "是" : "否")</td><td>@if (User.IsInRole("ADMIN") || User.IsInRole("PROPERTY_MANAGER")) { <form asp-action="RemoveRenter" method="post"><input type="hidden" name="id" value="@Model.TenancyId" /><input type="hidden" name="renterId" value="@renter.RenterId" /><button class="go-link-button" type="submit">移除</button></form> }</td></tr> }</tbody></table></div></section>
<script>document.addEventListener('DOMContentLoaded',function(){const table=document.querySelector('.go-panel .go-table');if(!table)return;const rows=[...table.querySelectorAll('tbody tr')];const values=[@foreach(var renter in Model.Renters){<text>{id:'@renter.RenterId',email:'@(renter.Renter.Email ?? "—")'},</text>}];const head=table.querySelector('thead tr');const idHead=document.createElement('th');idHead.textContent='租客 ID';const emailHead=document.createElement('th');emailHead.textContent='Email';head.prepend(emailHead);head.prepend(idHead);rows.forEach((row,i)=>{const id=document.createElement('td');id.textContent=values[i]?.id||'—';const email=document.createElement('td');email.textContent=values[i]?.email||'—';row.prepend(email);row.prepend(id);});});</script>
<script>document.addEventListener('DOMContentLoaded',function(){const table=document.querySelector('.go-panel .go-table');if(!table)return;const head=table.querySelector('thead tr');const emailHead=head.children[1];head.appendChild(emailHead);table.querySelectorAll('tbody tr').forEach(row=>row.appendChild(row.children[1]));});</script>
<script>document.addEventListener('DOMContentLoaded',function(){setTimeout(function(){const table=document.querySelector('.go-panel .go-table');if(!table)return;const head=table.querySelector('thead tr');const emailHead=head.children[1],phoneHead=head.children[5];head.insertBefore(phoneHead,head.children[2]);head.insertBefore(emailHead,head.children[3]);table.querySelectorAll('tbody tr').forEach(row=>{const email=row.children[1],phone=row.children[5];row.insertBefore(phone,row.children[2]);row.insertBefore(email,row.children[3]);});},0);});</script>
<script>document.addEventListener('DOMContentLoaded',function(){setTimeout(function(){const table=document.querySelector('.go-panel .go-table');if(!table)return;const headers=[...table.querySelectorAll('thead th')];const index=Object.fromEntries(headers.map((h,i)=>[h.textContent.trim(),i]));const desired=['租客 ID','租客姓名','电话号码','Email','主租客','操作'];const head=table.querySelector('thead tr');desired.forEach(name=>{const i=index[name];if(i!==undefined)head.appendChild(headers[i]);});table.querySelectorAll('tbody tr').forEach(row=>{const cells=[...row.children];desired.forEach(name=>{const i=index[name];if(i!==undefined)row.appendChild(cells[i]);});});},50);});</script>
