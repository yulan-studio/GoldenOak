@model Web.Models.Tenancy
@{ ViewData["Title"] = "租约详情"; }
<div class="go-page-header"><div><h1 class="go-page-title">租约详情</h1><div class="go-page-subtitle">房源：@Model.Unit.UnitNumber</div></div>@if (User.IsInRole("ADMIN") || User.IsInRole("PROPERTY_MANAGER")) { <div class="go-header-actions"><a class="go-btn-primary" asp-action="Edit" asp-route-id="@Model.TenancyId">编辑</a><a class="go-btn-back" asp-action="AddRenter" asp-route-id="@Model.TenancyId">添加租客</a></div> }</div>
<section class="go-panel"><dl><dt>租期</dt><dd>@Model.LeaseStartDate 至 @Model.LeaseEndDate</dd><dt>月租金</dt><dd>@Model.MonthlyRent.ToString("C2")</dd><dt>押金</dt><dd>@Model.DepositAmount.ToString("C2")</dd><dt>状态</dt><dd>@Model.Status</dd></dl>@if (User.IsInRole("ADMIN") || User.IsInRole("PROPERTY_MANAGER")) { <form asp-action="ChangeStatus" method="post"><input type="hidden" name="id" value="@Model.TenancyId" /><select name="status"><option>PENDING</option><option>ACTIVE</option><option>ENDED</option><option>CANCELLED</option></select><button class="go-btn-primary" type="submit">修改状态</button></form> }<h2>租客</h2><ul>@foreach (var renter in Model.Renters) { <li>@renter.RenterId @(renter.IsPrimary ? "（主租客）" : "") @if (User.IsInRole("ADMIN") || User.IsInRole("PROPERTY_MANAGER")) { <form asp-action="RemoveRenter" method="post" style="display:inline"><input type="hidden" name="id" value="@Model.TenancyId" /><input type="hidden" name="renterId" value="@renter.RenterId" /><button type="submit">移除</button></form> }</li>}</ul></section>
