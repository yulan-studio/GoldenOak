@model Web.Models.Tenancy
@{ ViewData["Title"] = "租约详情"; }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<script>document.addEventListener('DOMContentLoaded',function(){const s=document.querySelector('select[name="status"]');if(s){const o=document.createElement('option');o.value='';o.textContent='选择状态';o.disabled=true;o.selected=true;s.insertBefore(o,s.firstChild);s.value='';}});</script>
<div class="go-page-header"><div><h1 class="go-page-title">租约详情</h1><div class="go-page-subtitle">房源：@Model.Unit.UnitNumber</div></div><div class="go-header-actions"><a class="go-btn-back" asp-action="Index">返回租约列表</a>@if (User.IsInRole("ADMIN") || User.IsInRole("PROPERTY_MANAGER")) { <a class="go-btn-primary" asp-action="Edit" asp-route-id="@Model.TenancyId">编辑</a><a class="go-btn-back" asp-action="AddRenter" asp-route-id="@Model.TenancyId">添加租客</a> }</div></div>
<section class="go-panel"><dl><dt>租期</dt><dd>@Model.LeaseStartDate 至 @Model.LeaseEndDate</dd><dt>月租金</dt><dd>@Model.MonthlyRent.ToString("C2")</dd><dt>押金</dt><dd>@Model.DepositAmount.ToString("C2")</dd><dt>状态</dt><dd>@Model.Status</dd></dl>@if (User.IsInRole("ADMIN") || User.IsInRole("PROPERTY_MANAGER")) { <form asp-action="ChangeStatus" method="post"><input type="hidden" name="id" value="@Model.TenancyId" /><select name="status"><option>PENDING</option><option>ACTIVE</option><option>ENDED</option><option>CANCELLED</option></select><button class="go-btn-primary" type="submit">修改状态</button></form> }<h2>租客信息</h2><div class="table-responsive"><table class="go-table"><thead><tr><th>租客 ID</th><th>邮箱</th><th>主租客</th><th>添加时间</th><th>操作</th></tr></thead><tbody>@foreach (var renter in Model.Renters) { <tr><td>@renter.RenterId</td><td>@(renter.Renter.Email ?? "—")</td><td>@(renter.IsPrimary ? "是" : "否")</td><td>@renter.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@if (User.IsInRole("ADMIN") || User.IsInRole("PROPERTY_MANAGER")) { <form asp-action="RemoveRenter" method="post"><input type="hidden" name="id" value="@Model.TenancyId" /><input type="hidden" name="renterId" value="@renter.RenterId" /><button type="submit">移除</button></form> }</td></tr> }</tbody></table></div></section>
