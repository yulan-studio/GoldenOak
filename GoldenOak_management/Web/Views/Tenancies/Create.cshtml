@model Web.Models.CreateTenancyViewModel
@{ ViewData["Title"] = "创建租约"; }
@{ var buildings = (IEnumerable<Web.Models.Building>)ViewBag.Buildings; var renters = (IEnumerable<Web.Models.RenterProfile>)ViewBag.Renters; }
<div class="go-page-header"><div><h1 class="go-page-title">创建租约</h1></div><div class="go-header-actions"><a class="go-btn-back" asp-action="Index">返回租约列表</a></div></div>
<form asp-action="Create" method="post" id="tenancy-form"><div asp-validation-summary="All" class="text-danger"></div>
<div><label asp-for="BuildingId">1. 选择楼栋</label><select asp-for="BuildingId" id="building-select"><option value="">请选择楼栋</option>@foreach (var b in buildings) { <option value="@b.BuildingId">@b.BuildingName</option> }</select></div>
<div><label asp-for="UnitId">2. 选择房源</label><select asp-for="UnitId" id="unit-select"><option value="">请先选择楼栋</option>@foreach (var b in buildings) { foreach (var u in b.Units.Where(x => x.Status == "AVAILABLE" || x.Status == "RESERVED")) { <option value="@u.UnitId" data-building="@b.BuildingId">@b.BuildingName - @u.UnitNumber</option> } }</select></div>
<div><label asp-for="PrimaryRenterId">3. 选择租客</label><select asp-for="PrimaryRenterId"><option value="">请选择租客</option>@foreach (var r in renters) { <option value="@r.UserId">@r.FullName</option> }</select></div>
<div><label asp-for="LeaseStartDate">4. 开始日期</label><input asp-for="LeaseStartDate" type="date" /></div><div><label asp-for="LeaseEndDate">结束日期</label><input asp-for="LeaseEndDate" type="date" /></div>
<div><label asp-for="MonthlyRent">5. 月租金</label><input asp-for="MonthlyRent" type="number" min="0" step="0.01" /></div><div><label asp-for="DepositAmount">6. 押金</label><input asp-for="DepositAmount" type="number" min="0" step="0.01" /></div><div><label asp-for="DepositReceivedDate">押金收取日期</label><input asp-for="DepositReceivedDate" type="date" /></div>
<button class="go-btn-primary" type="submit">7. 保存租约</button><a asp-action="Index">取消</a></form>
<script>document.getElementById('building-select').addEventListener('change',function(){const b=this.value;const u=document.getElementById('unit-select');[...u.options].forEach(o=>{o.hidden=o.value && o.dataset.building!==b;o.selected=false});u.value='';});</script>
