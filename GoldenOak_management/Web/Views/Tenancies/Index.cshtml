@model List<Web.Models.Tenancy>
@{ ViewData["Title"] = L["TenancyList"]; }
<div class="go-page-header"><div><div class="go-eyebrow">@L["TenancyManagement"]</div><h1 class="go-page-title">@L["TenancyList"]</h1></div>@if (User.IsInRole("ADMIN") || User.IsInRole("PROPERTY_MANAGER")) { <div class="go-header-actions"><a class="go-btn-primary" asp-action="Create">＋ @L["CreateTenancy"]</a></div> }</div>
<section class="go-panel"><div class="table-responsive"><table class="go-table"><thead><tr><th>@L["BuildingAddress"]</th><th>@L["UnitNumber"]</th><th>@L["StartDate"]</th><th>@L["EndDate"]</th><th>@L["MonthlyRent"]</th><th>@L["Status"]</th><th>@L["Actions"]</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Unit.Building.AddressLine1, @item.Unit.Building.City, @item.Unit.Building.Province</td><td>@item.Unit.UnitNumber</td><td>@item.LeaseStartDate</td><td>@item.LeaseEndDate</td><td>@item.MonthlyRent.ToString("C2")</td><td>@item.Status</td><td><a asp-action="Details" asp-route-id="@item.TenancyId">@L["Details"]</a></td></tr> }</tbody></table></div></section>
