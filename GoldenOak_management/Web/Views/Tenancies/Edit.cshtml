@model Web.Models.EditTenancyViewModel
@{ ViewData["Title"] = L["EditTenancy"]; }
<div class="go-page-header"><div><div class="go-eyebrow">@L["TenancyManagement"]</div><h1 class="go-page-title">@L["EditTenancy"]</h1><div class="go-page-subtitle">Update lease dates, rent and deposit information</div></div><div class="go-header-actions"><a class="go-btn-back" asp-action="Details" asp-route-id="@Model.TenancyId">@L["TenancyDetails"]</a></div></div>
<form asp-action="Edit" method="post" class="go-panel go-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="TenancyId" type="hidden" /><input asp-for="UnitId" type="hidden" /><div class="go-form-grid"><div><label asp-for="MonthlyRent">@L["MonthlyRent"]</label><input asp-for="MonthlyRent" class="form-control" type="number" min="0" step="0.01" /></div><div><label asp-for="DepositAmount">@L["DepositAmount"]</label><input asp-for="DepositAmount" class="form-control" type="number" min="0" step="0.01" /></div><div><label asp-for="DepositReceivedDate">@L["DepositReceivedDate"]</label><input asp-for="DepositReceivedDate" class="form-control" type="date" /></div></div><div class="go-form-grid"><div><label asp-for="LeaseStartDate">@L["StartDate"]</label><input asp-for="LeaseStartDate" class="form-control" type="date" /></div><div><label asp-for="LeaseEndDate">@L["EndDate"]</label><input asp-for="LeaseEndDate" class="form-control" type="date" /></div></div><div class="go-form-actions"><button class="go-btn-primary" type="submit">@L["SaveEdit"]</button><a class="go-btn-secondary" asp-action="Details" asp-route-id="@Model.TenancyId">@L["Cancel"]</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
