@model Web.Models.EditTenancyViewModel
@{ ViewData["Title"] = "修改租约"; }
<div class="go-page-header"><div><div class="go-eyebrow">租约管理</div><h1 class="go-page-title">修改租约</h1><div class="go-page-subtitle">更新租期、租金和押金信息</div></div><div class="go-header-actions"><a class="go-btn-back" asp-action="Details" asp-route-id="@Model.TenancyId">返回租约详情</a></div></div>
<form asp-action="Edit" method="post" class="go-panel go-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="TenancyId" type="hidden" /><input asp-for="UnitId" type="hidden" /><div class="go-form-grid"><div><label asp-for="MonthlyRent">月租金</label><input asp-for="MonthlyRent" class="form-control" type="number" min="0" step="0.01" /></div><div><label asp-for="DepositAmount">押金</label><input asp-for="DepositAmount" class="form-control" type="number" min="0" step="0.01" /></div><div><label asp-for="DepositReceivedDate">押金收取日期</label><input asp-for="DepositReceivedDate" class="form-control" type="date" /></div></div><div class="go-form-grid"><div><label asp-for="LeaseStartDate">开始日期</label><input asp-for="LeaseStartDate" class="form-control" type="date" /></div><div><label asp-for="LeaseEndDate">结束日期</label><input asp-for="LeaseEndDate" class="form-control" type="date" /></div></div><div class="go-form-actions"><button class="go-btn-primary" type="submit">保存修改</button><a class="go-btn-secondary" asp-action="Details" asp-route-id="@Model.TenancyId">取消</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
