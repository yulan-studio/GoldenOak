@model IEnumerable<Web.Models.OwnerSummaryViewModel>
<section id="owner-info" class="go-panel mt-4"><h2>@L["OwnerInformation"]</h2><div class="table-responsive"><table class="go-table"><thead><tr><th>Owner ID</th><th>@L["Name"]</th><th>@L["Phone"]</th><th>@L["Email"]</th><th>Ownership %</th><th>Primary Payout Owner</th></tr></thead><tbody>@foreach (var owner in Model) { <tr><td>@owner.OwnerId</td><td>@owner.FullName</td><td>@(owner.PhoneNumber ?? "—")</td><td>@(owner.Email ?? "—")</td><td>@owner.OwnershipPercentage.ToString("0.##")%</td><td>@(owner.IsPrimaryPayoutOwner ? "Yes" : "No")</td></tr> }</tbody></table></div></section>
