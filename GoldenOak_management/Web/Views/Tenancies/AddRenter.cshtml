@model Web.Models.Tenancy
@{ ViewData["Title"] = "添加租客"; }
<div class="go-page-header"><div><div class="go-eyebrow">租约管理</div><h1 class="go-page-title">添加租客</h1><div class="go-page-subtitle">为房源 @Model.Unit.UnitNumber 添加租客</div></div><div class="go-header-actions"><a class="go-btn-back" asp-action="Details" asp-route-id="@Model.TenancyId">返回租约详情</a></div></div>
<form asp-action="AddRenter" method="post" class="go-panel go-form"><input type="hidden" name="id" value="@Model.TenancyId" /><div class="go-form-grid"><div><label for="renterId">租客 User ID</label><input id="renterId" name="renterId" class="form-control" type="number" min="1" required /></div><div><label><input name="isPrimary" type="checkbox" value="true" /> 设为主租客</label></div></div><div class="go-form-actions"><button class="go-btn-primary" type="submit">添加租客</button><a class="go-btn-secondary" asp-action="Details" asp-route-id="@Model.TenancyId">取消</a></div></form>
