@using Microsoft.Extensions.Localization
@using Web
@inject IStringLocalizer<SharedResource> L
<!DOCTYPE html>
<html lang="@(System.Globalization.CultureInfo.CurrentUICulture.Name)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GoldenOak</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="go-app-shell">
        <aside class="go-sidebar">
            <a class="go-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="go-brand-mark"><img src="~/images/golden-oak-logo.png" alt="GoldenOak logo" /></span>
                <span><strong>GoldenOak</strong><small>Asset Management</small></span>
            </a>

            <div class="go-nav-label">@L["Workspace"]</div>
            <nav class="go-nav" aria-label="Main navigation">
                <a class="go-nav-item active" asp-area="" asp-controller="Home" asp-action="Index"><span>⌂</span>@L["Dashboard"]</a>
                <a class="go-nav-item" asp-area="" asp-controller="Buildings" asp-action="Index"><span>▦</span>@L["PropertiesAndLeases"]</a>
                <a class="go-nav-item" asp-area="" asp-controller="Tenancies" asp-action="Index"><span>▤</span>@L["TenancyList"]</a>
                <a class="go-nav-item" asp-area="" asp-controller="Tenants" asp-action="Index"><span>♙</span>@L["RenterManagement"]</a>
                <a class="go-nav-item" href="#"><span>◈</span>@L["RentAndTrustLedger"]</a>
                <a class="go-nav-item" href="#"><span>⚒</span>@L["Maintenance"]</a>
                <a class="go-nav-item" href="#"><span>⌂</span>@L["Leasing"]</a>
                <a class="go-nav-item" href="#"><span>▤</span>@L["Reports"]</a>
            </nav>

            <div class="go-nav-label">@L["Governance"]</div>
            <nav class="go-nav">
                <a class="go-nav-item" href="#"><span>◉</span>@L["UsersAndPermissions"]</a>
                <a class="go-nav-item" href="#"><span>◇</span>@L["DatabaseDesign"]</a>
            </nav>

            <div class="go-sidebar-footer">Phase 1 MVP · RBAC + Trust Ledger<br />Canadian privacy ready</div>
        </aside>

        <div class="go-main-shell">
            <header class="go-topbar">
                <div class="go-breadcrumb">GoldenOak Portal <span>/</span> <strong>@ViewData["Title"]</strong></div>
                <div class="go-topbar-actions">
                    <form asp-controller="Home" asp-action="SetLanguage" method="post" class="go-language-switcher">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <select name="culture" aria-label="@L["Language"]" onchange="this.form.submit()">
                            <option value="zh-CN" selected="@(System.Globalization.CultureInfo.CurrentUICulture.Name == "zh-CN")">@L["Chinese"]</option>
                            <option value="en-US" selected="@(System.Globalization.CultureInfo.CurrentUICulture.Name == "en-US")">@L["English"]</option>
                        </select>
                    </form>
                    <partial name="_LoginPartial" />
                </div>
            </header>

            <main class="go-content" role="main">
                @RenderBody()
            </main>

            <footer class="go-footer">
                <span>© 2026 GoldenOak Asset Management</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">@L["Privacy"]</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
