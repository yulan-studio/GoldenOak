@using Microsoft.AspNetCore.Identity
@using Web.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="go-user-actions">
@if (SignInManager.IsSignedIn(User))
{
    <a class="go-user-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
        <span class="go-user-avatar" aria-label="Property Manager">PM</span>
        <span class="go-user-copy"><small>Hello</small><strong>@User.Identity?.Name</strong></span>
    </a>
    <form class="go-logout-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="go-logout-button">Logout</button>
        </form>
}
else
{
    <a class="go-auth-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
    <a class="go-auth-link go-auth-primary" asp-area="Identity" asp-page="/Account/Login">Login</a>
}
</div>
