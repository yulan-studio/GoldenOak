@using Microsoft.AspNetCore.Identity
@using Web.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="go-user-actions">
@if (SignInManager.IsSignedIn(User))
{
    var userBadge = "U";
    var userBadgeLabel = "User";
    if (User.IsInRole("ADMIN"))
    {
        userBadge = "A";
        userBadgeLabel = "Administrator";
    }
    else if (User.IsInRole("PROPERTY_MANAGER"))
    {
        userBadge = "PM";
        userBadgeLabel = "Property Manager";
    }
    else if (User.IsInRole("OWNER"))
    {
        userBadge = "O";
        userBadgeLabel = "Owner";
    }
    else if (User.IsInRole("RENTER"))
    {
        userBadge = "T";
        userBadgeLabel = "Tenant";
    }
    else if (User.IsInRole("CONTRACTOR"))
    {
        userBadge = "C";
        userBadgeLabel = "Contractor";
    }
    else if (User.IsInRole("REALTOR"))
    {
        userBadge = "R";
        userBadgeLabel = "Realtor";
    }
    <a class="go-user-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
        <span class="go-user-avatar" aria-label="@userBadgeLabel">@userBadge</span>
        <span class="go-user-copy"><small>Hello</small><strong>@User.Identity?.Name</strong></span>
    </a>
    <form class="go-logout-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="go-logout-button">Logout</button>
        </form>
}
else
{
    <a class="go-auth-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
    <a class="go-auth-link go-auth-primary" asp-area="Identity" asp-page="/Account/Login">Login</a>
}
</div>
